# Mac studio — OpenMontage compose + LM Studio. Not the public fleet.
# M4 Pro 48 GB is enough for 2–4 interactive 30B streams.
# Do not wait for M5 to serve 450–550 concurrent users.

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen/qwen3-coder-30b
PUBLIC_DOMAIN=localhost

# Optional named tunnel so Hostinger can fall back to this Mac.
# Never give clients the tunnel URL. See services/hermes-api/cloudflared.yml.example
# CLOUDFLARED_TUNNEL_ID=
