# Phase 0 — hosted OpenAI-compatible NVIDIA API (no GPU purchase).
# Point Hermes INFERENCE_* at the vendor. Examples: Fireworks, Together, Groq.
# Do not subscribe from this repo; paste a key you already have.

INFERENCE_BACKEND=hosted
INFERENCE_BASE_URL=https://api.fireworks.ai/inference/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=accounts/fireworks/models/qwen3-30b-a3b

# If the vendor uses a different OpenAI mount, keep the trailing /v1.
# Hermes on Hostinger still requires HERMES_API_KEY for public /v1.
