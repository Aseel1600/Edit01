# AMD Instinct cost-play only (MI300X / MI325X / MI355X). Not Radeon.
# Default serving path is NVIDIA (compose/docker-compose.vllm.yml).
# Do not mix AMD and NVIDIA in one vLLM pool.

HF_TOKEN=
INFERENCE_API_KEY=
VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct
VLLM_SERVED_NAME=qwen3-30b-a3b
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=32768
VLLM_PORT=8000
