# Phase 1 NVIDIA node — rent 2x H100 80GB (or 1–2x H200) before buying.
# Phase 2: set TENSOR_PARALLEL_SIZE=8 on an 8-GPU box (12–16 GPUs = two boxes).
# Used with compose/docker-compose.vllm.yml

HF_TOKEN=
INFERENCE_API_KEY=
VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct
VLLM_SERVED_NAME=qwen3-30b-a3b
TENSOR_PARALLEL_SIZE=2
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
VLLM_PORT=8000

# Optional: pin the image instead of :latest
# VLLM_IMAGE=vllm/vllm-openai:v0.10.2
